<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Multi-target: net48 (100% native on Win10/11, <1MB) & net8.0-windows (modern .NET) -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ScreensaverExtender</RootNamespace>
    <AssemblyName>ScreensaverExtender</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    
    <!-- Versioning & Metadata -->
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Authors>slalglel</Authors>
    <Company>Personal Project</Company>
    <Product>Smart Screensaver Extender</Product>
    <Description>A lightweight, zero-overhead Windows utility that extends screensaver delay safely based on user idle time without physical mouse interference.</Description>

    <!-- Publish Settings for Single File Portable Exe -->
    <PublishSingleFile Condition="'$(TargetFramework)' == 'net8.0-windows'">true</PublishSingleFile>
    <SelfContained Condition="'$(TargetFramework)' == 'net8.0-windows'">false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(TargetFramework)' == 'net8.0-windows'">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
